# Docker environment variables for test-runner service
# Used by docker-compose.yml — override per-environment values

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=dev
BASE_URL=https://demoqa.com
API_BASE_URL=https://demoqa.com

# ── Browser ──────────────────────────────────────────────────
BROWSER=chrome
HEADLESS=true

# ── Test Credentials ─────────────────────────────────────────
TEST_USERNAME=testuser_demo
TEST_PASSWORD=Test@12345
ADMIN_USERNAME=admin_demo
ADMIN_PASSWORD=Admin@12345

# ── Database (points to mysql service in compose network) ────
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=test_automation_db
DB_USER=automation_user
DB_PASSWORD=AutomationDB@123

# ── Selenium Grid ────────────────────────────────────────────
USE_SELENIUM_GRID=true
SELENIUM_GRID_URL=http://selenium-hub:4444/wd/hub

# ── AI & Reporting ───────────────────────────────────────────
AI_ENABLED=true
SELF_HEALING_ENABLED=true
BUG_PREDICTION_ENABLED=true
SCREENSHOT_ON_FAILURE=true
LOG_LEVEL=INFO

# ── Timeouts ─────────────────────────────────────────────────
EXPLICIT_WAIT=30
PAGE_LOAD_TIMEOUT=90
