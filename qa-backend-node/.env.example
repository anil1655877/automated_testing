# 🟢 Server Configuration
PORT=5000
NODE_ENV=development

# 🗄️ Database Configurations
# If left blank, server falls back to SQLite automatic file-based connection (database.sqlite)
DATABASE_URL=postgres://qa_platform_user:SecurePlatformPassword123@localhost:5432/qa_automation_platform
DATABASE_SSL=false

# 🛡️ File Size Limitations
MAX_FILE_SIZE_MB=50
