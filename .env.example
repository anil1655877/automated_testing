# ============================================================
# AI-Enhanced Enterprise Test Automation Framework
# Environment Variables Template
# Copy this to .env and update with your values
# NEVER commit .env to version control
# ============================================================

# ── Application URLs ────────────────────────────────────────
BASE_URL=https://your-app.example.com
API_BASE_URL=https://api.your-app.example.com
ADMIN_URL=https://admin.your-app.example.com

# ── Browser Configuration ────────────────────────────────────
BROWSER=chrome
HEADLESS=false
BROWSER_TIMEOUT=30
IMPLICIT_WAIT=10
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=60

# ── Test Environment ─────────────────────────────────────────
ENVIRONMENT=dev
# Options: dev | staging | production

# ── User Credentials ─────────────────────────────────────────
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=Admin@123
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=TestUser@123
READONLY_USERNAME=readonly@example.com
READONLY_PASSWORD=ReadOnly@123

# ── Database Configuration ───────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=test_automation_db
DB_USER=automation_user
DB_PASSWORD=AutomationDB@123
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── SQLite Fallback ──────────────────────────────────────────
SQLITE_DB_PATH=data/test_db.sqlite

# ── API Configuration ────────────────────────────────────────
API_TIMEOUT=30
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
JWT_SECRET=your_jwt_secret_here

# ── Reporting ────────────────────────────────────────────────
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=reports/screenshots
HTML_REPORT_DIR=reports/html-reports
ALLURE_RESULTS_DIR=reports/allure-results

# ── Parallel Execution ───────────────────────────────────────
PARALLEL_WORKERS=4
# -1 = use all CPU cores

# ── Retry Configuration ──────────────────────────────────────
MAX_RETRIES=2
RETRY_DELAY=3

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs

# ── AI Module Configuration ──────────────────────────────────
AI_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.85
SELF_HEALING_ENABLED=true
BUG_PREDICTION_ENABLED=true

# ── Selenium Grid (optional) ─────────────────────────────────
SELENIUM_GRID_URL=http://localhost:4444/wd/hub
USE_SELENIUM_GRID=false

# ── Notification (optional) ──────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
EMAIL_NOTIFICATIONS=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
